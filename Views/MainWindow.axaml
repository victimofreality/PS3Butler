<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PS3Butler.ViewModels"
    xmlns:models="using:PS3Butler.Models"
    mc:Ignorable="d"
    d:DesignWidth="1000"
    d:DesignHeight="750"
    x:Class="PS3Butler.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Title="PS3 Butler"
    Width="1000"
    Height="750"
    MinWidth="800"
    MinHeight="600">

	<ScrollViewer>
		<StackPanel Margin="30" Spacing="24">

			<TextBlock
                Text="{Binding Greeting}"
                FontSize="32"
                FontWeight="Bold" />

			<Border
                Padding="18"
                BorderThickness="1"
                CornerRadius="8">

				<StackPanel Spacing="12">

					<TextBlock
                        Text="Settings"
                        FontSize="20"
                        FontWeight="SemiBold" />

					<TextBlock Text="PS3Dec (Redrrx)" />

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<TextBox
							Grid.Column="0"
							Text="{Binding RedrrxPs3DecPath}" />

						<Button
							Grid.Column="1"
							Content="Browse..."
							Command="{Binding BrowseRedrrxPs3DecCommand}" />
					</Grid>

					<TextBlock Text="7-Zip" />

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<TextBox
							Grid.Column="0"
							Text="{Binding SevenZipPath}" />

						<Button
							Grid.Column="1"
							Content="Browse..."
							Command="{Binding BrowseSevenZipCommand}" />
					</Grid>

					<TextBlock Text="Redump key directory" />

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<TextBox
							Grid.Column="0"
							Text="{Binding RedumpKeysPath}" />

						<Button
							Grid.Column="1"
							Content="Browse..."
							Command="{Binding BrowseRedumpKeysCommand}" />
					</Grid>

					<TextBlock Text="Work directory" />

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<TextBox
							Grid.Column="0"
							Text="{Binding WorkDirectory}" />

						<Button
							Grid.Column="1"
							Content="Browse..."
							Command="{Binding BrowseWorkDirectoryCommand}" />
					</Grid>

					<TextBlock Text="ISO destination" />

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<TextBox
							Grid.Column="0"
							Text="{Binding IsoDestinationPath}" />

						<Button
							Grid.Column="1"
							Content="Browse..."
							Command="{Binding BrowseIsoDestinationCommand}" />
					</Grid>

					<TextBlock Text="JB folder destination" />

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<TextBox
							Grid.Column="0"
							Text="{Binding JbDestinationPath}" />

						<Button
							Grid.Column="1"
							Content="Browse..."
							Command="{Binding BrowseJbDestinationCommand}" />
					</Grid>
					
					<TextBlock Text="PS3Dec thread count" />

					<NumericUpDown
                        Value="{Binding Ps3DecThreadCount}"
                        Minimum="1"
                        Maximum="256"
                        Increment="1"
                        Width="140"
                        HorizontalAlignment="Left" />

					<CheckBox
						Content="Remove PS3_UPDATE from JB folder output"
						IsChecked="{Binding RemovePs3Update}" />					
					
					<StackPanel
                        Orientation="Horizontal"
                        Spacing="12">

						<Button
                            Content="Save Settings"
                            Command="{Binding SaveSettingsCommand}" />

						<TextBlock
                            Text="{Binding SettingsStatus}"
                            VerticalAlignment="Center" />

					</StackPanel>

					<Separator />

					<TextBlock
                        Text="{Binding SettingsMode, StringFormat='Mode: {0}'}" />

					<TextBlock
                        Text="{Binding SettingsLocation, StringFormat='Settings file: {0}'}"
                        TextWrapping="Wrap" />

				</StackPanel>

			</Border>

			<Border
				Padding="18"
				BorderThickness="1"
				CornerRadius="8">

				<StackPanel Spacing="12">

					<StackPanel Spacing="10">

						<TextBlock
							Text="Queue"
							FontSize="20"
							FontWeight="SemiBold" />

						<StackPanel
							Orientation="Horizontal"
							Spacing="10">

							<Button
								Content="Add Local Games..."
								Command="{Binding AddLocalGamesCommand}"
								IsEnabled="{Binding CanEditQueue}" />

							<Button
								Content="Process Ready Jobs"
								Command="{Binding ProcessReadyJobsCommand}"
								IsEnabled="{Binding CanEditQueue}" />
							
							<Button
								Content="Pause Download"
								Command="{Binding PauseDownloadCommand}" />

							<Button
								Content="Resume Download"
								Command="{Binding ResumeDownloadCommand}" />
							
							<Button
								Content="Cancel"
								Command="{Binding CancelDownloadCommand}" />

						</StackPanel>
						
						<Grid
							ColumnDefinitions="*,Auto"
							ColumnSpacing="10">

							<TextBox
								Grid.Column="0"
								Watermark="HTTP/HTTPS game URL"
								Text="{Binding UrlToAdd, Mode=TwoWay}" />

							<Button
								Grid.Column="1"
								Content="Add URL"
								Command="{Binding AddUrlCommand}"
								IsEnabled="{Binding CanEditQueue}" />
							
						</Grid>

						<StackPanel
							Orientation="Horizontal"
							Spacing="10">

							<Button
								Content="Preflight Queue"
								Command="{Binding PreflightQueueCommand}"
								IsEnabled="{Binding CanEditQueue}" />

							<Button
								Content="Retry Selected"
								Command="{Binding RetrySelectedJobCommand}"
								IsEnabled="{Binding CanEditQueue}" />

							<Button
								Content="Remove Selected"
								Command="{Binding RemoveSelectedJobCommand}"
								IsEnabled="{Binding CanEditQueue}" />

							<Button
								Content="Clear Completed"
								Command="{Binding ClearCompletedJobsCommand}"
								IsEnabled="{Binding CanEditQueue}" />

							<Button
								Content="Clear Queue"
								Command="{Binding ClearQueueCommand}"
								IsEnabled="{Binding CanEditQueue}" />
							
						</StackPanel>

					</StackPanel>

					<ListBox
						ItemsSource="{Binding Jobs}"
						SelectedItem="{Binding SelectedJob}">

						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="models:GameJob">

								<Border
									Margin="0,0,0,8"
									Padding="12"
									BorderThickness="1"
									CornerRadius="6">

									<Grid
										ColumnDefinitions="*,Auto"
										ColumnSpacing="15">

										<StackPanel
											Grid.Column="0"
											Spacing="4">

											<TextBlock
												Text="{Binding DisplayName}"
												FontWeight="SemiBold" />


											<ComboBox
												Width="180"
												HorizontalAlignment="Left"
												ItemsSource="{x:Static models:GameJob.AvailableOutputFormats}"
												IsEnabled="{Binding $parent[Window].DataContext.CanEditQueue}"
												SelectedValue="{Binding OutputFormat}"
												SelectedValueBinding="{ReflectionBinding Path=Value}">
												<ComboBox.ItemTemplate>
													<DataTemplate x:DataType="models:OutputFormatOption">
														<TextBlock Text="{Binding Name}" />
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>

											<Grid
												ColumnDefinitions="*,Auto"
												ColumnSpacing="8"
												HorizontalAlignment="Left"
												Width="520">

												<TextBox
													Grid.Column="0"
													Watermark="Destination override (blank = default)"
													Text="{Binding DestinationOverride, Mode=TwoWay}"
													IsEnabled="{Binding $parent[Window].DataContext.CanEditQueue}" />

												<Button
													Grid.Column="1"
													Content="Browse..."
													Command="{Binding $parent[Window].DataContext.BrowseJobDestinationCommand}"
													CommandParameter="{Binding}"
													IsEnabled="{Binding $parent[Window].DataContext.CanEditQueue}"	/>

											</Grid>
											<TextBlock
												Text="{Binding SourcePath}"
												FontSize="12"
												TextWrapping="Wrap" />

											<TextBlock
												Text="{Binding Details}"
												FontSize="12"
												TextWrapping="Wrap" />
	
											<TextBlock
												Text="{Binding CurrentStage}"
												FontSize="12" />

											<ProgressBar
												Minimum="0"
												Maximum="100"
												Value="{Binding Progress}"
												Height="8" />
									
											<TextBlock
												Text="{Binding EtaText}"
												FontSize="12" />										
		
										</StackPanel>

										<TextBlock
											Grid.Column="1"
											Text="{Binding Status}"
											VerticalAlignment="Center" />

									</Grid>

								</Border>

							</DataTemplate>
						</ListBox.ItemTemplate>

					</ListBox>

				</StackPanel>

			</Border>
			

		</StackPanel>
	</ScrollViewer>

</Window>
