<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PS3Butler.ViewModels"
    xmlns:models="using:PS3Butler.Models"
    mc:Ignorable="d"
    d:DesignWidth="900"
    d:DesignHeight="600"
    x:Class="PS3Butler.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Title="PS3 Butler"
    Width="900"
    Height="600">

	<ScrollViewer>
		<StackPanel Margin="30" Spacing="20">

			<TextBlock
                Text="{Binding Greeting}"
                FontSize="32"
                FontWeight="Bold" />

			<TextBlock
                Text="Dependency check"
                FontSize="20"
                FontWeight="SemiBold" />

			<ItemsControl ItemsSource="{Binding Tools}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="models:ToolStatus">
						<Border
                            Margin="0,0,0,10"
                            Padding="15"
                            BorderThickness="1"
                            CornerRadius="6">

							<StackPanel Spacing="5">

								<TextBlock
                                    Text="{Binding Name}"
                                    FontSize="16"
                                    FontWeight="SemiBold" />

								<TextBlock
                                    Text="{Binding StatusText}"
                                    TextWrapping="Wrap" />

							</StackPanel>

						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

		</StackPanel>
	</ScrollViewer>

</Window>